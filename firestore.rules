rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isString(val) {
      return val is string;
    }
    
    function isNumber(val) {
      return val is number;
    }
    
    function isList(val) {
      return val is list;
    }
    
    function isMap(val) {
      return val is map;
    }

    function isBoolean(val) {
      return val is bool;
    }

    // Public resources collection: allow read for everyone, write for resource directory management
    match /resources/{resourceId} {
      allow read, write: if true;
    }

    // Pending submissions: user-submitted proposals awaiting moderation
    match /pendingSubmissions/{submissionId} {
      allow read, write: if true;
    }

    // Approved history logs
    match /approvedHistory/{historyId} {
      allow read, write: if true;
    }

    // Chat sessions for emergency AI and counselor assistance
    match /chats/{roomId} {
      allow read, write: if true;
    }

    // Admin settings and login credentials
    match /adminSettings/{settingId} {
      allow read, write: if true;
    }

    // Catch-all default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

